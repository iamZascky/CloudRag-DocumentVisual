# Environment Variables & API Keys
# Rename this file to .env and fill in values if using cloud providers.

# Optional: Google Gemini API Key (for Gemini 2.5 Flash / Embeddings fallback)
GEMINI_API_KEY=

# Optional: Hugging Face Token (for faster downloads)
HF_TOKEN=

# Host and Port for API server
API_HOST=0.0.0.0
API_PORT=8000
