# Environment Variables & API Keys
# Rename this file to .env and fill in values if using cloud providers.

# WhatsApp Meta Cloud API Configuration
WHATSAPP_TOKEN=
PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=your_custom_secret_verify_token

# AI Provider Selection: 'cloud' (Google Gemini, lightweight for shared hosting) or 'local' (Qwen2.5-VL BF16 GPU)
AI_MODE=cloud

# Google Gemini API Key (Required if AI_MODE=cloud)
GEMINI_API_KEY=

# Optional: Hugging Face Token (for higher rate limits in local mode)
HF_TOKEN=

# Host and Port for API server
API_HOST=0.0.0.0
API_PORT=8000
